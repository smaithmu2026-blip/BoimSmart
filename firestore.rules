rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidQuiz(data) {
      return data.keys().hasAll(['title', 'questions', 'userId', 'createdAt']) &&
             data.title is string && data.title.size() <= 500 &&
             data.userId == request.auth.uid;
             // Relaxed timestamp and key checks for better stability
    }

    // Quiz rules
    match /users/{userId}/quizzes/{quizId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidQuiz(incoming());
      allow update: if isOwner(userId); // Allow updates for metadata or scoring
      allow delete: if isOwner(userId);
    }
  }
}

